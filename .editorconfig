root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{py,ps1,cpp,h,java}]
indent_style = space
indent_size = 4

[*.{sh,rb,js}]
indent_style = space
indent_size = 2

[*.bash]
indent_style = space
indent_size = 2

[ffmerge-er]
indent_style = space
indent_size = 4
